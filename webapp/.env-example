# Copy to .env and fill in a real value before running docker compose up.
SECRET_KEY="change_me_generate_your_own_secret_key"

# Optional: point at a real Postgres instance instead of the default SQLite
# file (e.g. postgresql://user:password@host:5432/dbname). Leave unset to
# use SQLite - no separate database container needed.
# DATABASE_URL=

# Optional: Google Cloud API key for the PageSpeed Insights integration.
# PSI_API_KEY=
